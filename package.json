{
  "name": "FIXHUB",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "android:check-config": "node scripts/validate-android-env.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "test:android": "node --test tests/android/config.test.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:supabase:sql": "node --test tests/supabase/*.test.mjs",
    "backend:generate": "firebase dataconnect:sdk:generate --project demo-fixhub",
    "backend:emulators": "firebase emulators:start --only auth,dataconnect --project demo-fixhub",
    "test:backend": "firebase emulators:exec --only auth,dataconnect --project demo-fixhub \"node --test --test-force-exit tests/backend/backend.test.mjs\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^12.11.0",
    "idb": "^8.0.4",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide": "^1.56.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.3.16",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "autoprefixer": "^10.6.1",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "15.34.1",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.30",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "description": "An Ionic project"
}
