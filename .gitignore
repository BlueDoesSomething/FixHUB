# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/tests/e2e/screenshots/
/tests/e2e/videos/
/tests/e2e/downloads/
/cypress/downloads/
/dist
/node_modules
/platforms
/plugins
/www

# Android credentials and build output
*.jks
*.keystore
key.properties
keystore.properties
*.apk
*.aab

# Firebase local state and private configuration
/.firebase/
/dataconnect/.dataconnect/
.env
.env.*
!.env.example
*service-account*.json
*serviceAccount*.json

# Supabase CLI state (can contain linked-project connection information)
/supabase/.temp/
/supabase/.branches/

# Local-only originals containing private test credentials
/.local-private/
