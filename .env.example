# Supabase is the chosen backend. Copy these public API values to .env.local.
# Authentication requires a configured Supabase connection; there is no offline sign-in.
# Never put a database password, connection string, secret key, or service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Previous Firebase foundation: retained for reference/tests, not used by Supabase.
# Firebase web configuration is public app identification, not Admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Never enable emulator connections in a deployed/production application.
VITE_FIREBASE_USE_EMULATORS=true

# Optional Leaflet tile-provider override. Set both values together.
# Defaults to OpenStreetMap standard tiles with visible OSM attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional Nominatim-compatible address-search endpoint and visible credit.
# Defaults to public Nominatim. Use a hosted provider/proxy for production traffic.
VITE_MAP_SEARCH_URL=
VITE_MAP_SEARCH_ATTRIBUTION=
